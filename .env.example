# Copy to .env to override defaults. All optional.
# Directory holding autonomy_levels.yaml, permissions.yaml, tool_registry.json, etc.
SYNKAGE_CONFIG_DIR=config
# DEBUG | INFO | WARNING | ERROR
SYNKAGE_LOG_LEVEL=INFO
# Where agent artifacts are written (one folder per command). Contains message text.
SYNKAGE_RUNS_DIR=runs
# Personal memory (profile, trust, audit log). Default ~/.synkage/memory, outside the repo.
# SYNKAGE_MEMORY_DIR=~/.synkage/memory
# Audit log of every routed action. Default <memory dir>/logs.jsonl.
# SYNKAGE_AUDIT_LOG=~/.synkage/memory/logs.jsonl
